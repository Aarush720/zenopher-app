# For the static web app on Cloudflare Pages (Vercel: the same values under "headers" in vercel.json).
# The app holds no secrets. Strict CSP, no inline scripts (spec 8.6).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' blob: data:; font-src 'self' blob:; connect-src 'self' https://api.example.com https://accounts.google.com; frame-src https://challenges.cloudflare.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
