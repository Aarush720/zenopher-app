# The local launcher supplies these defaults automatically.
APP_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000
LOCAL_AUTH_ENABLED=true
TURNSTILE_REQUIRED=false
CRITIQUE_ENABLED=false

# Optional: set a stable key yourself. If omitted, local-dev.mjs creates one
# under .wrangler/local-state (which is ignored by git).
# ZPH_MASTER_KEY=base64-encoded-32-byte-key
